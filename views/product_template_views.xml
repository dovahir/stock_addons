<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Vista Formulario de Product Template -->
    <record id="product_template_form_view_inherit_to_migrate" model="ir.ui.view">
        <field name="name">product.template.form.inherit.to.migrate</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='options']" position="inside">
                <span class="d-inline-block">
                    <field name="to_migrate"/>
                    <label for="to_migrate"/>
                </span>
            </xpath>
        </field>
    </record>

    <!-- Vista Lista (Tree) de Product Template -->
    <record id="product_template_tree_view_inherit_to_migrate" model="ir.ui.view">
        <field name="name">product.template.tree.inherit.to.migrate</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_tree_view"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="to_migrate" optional="show" widget="boolean_toggle"/>
            </field>
        </field>
    </record>

    <!-- Vista Kanban de Product Template -->
    <record id="product_template_kanban_view_inherit_to_migrate" model="ir.ui.view">
        <field name="name">product.template.kanban.inherit.to.migrate</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_kanban_view"/>
        <field name="arch" type="xml">
            <xpath expr="//kanban" position="inside">
                <field name="to_migrate"/>
            </xpath>
            <xpath expr="//div[@name='product_lst_price']" position="after">
                <div t-if="record.to_migrate.raw_value" class="mt-1">
                    <span class="badge rounded-pill text-bg-warning">
                        <i class="fa fa-truck me-1"/>Migrar
                    </span>
                </div>
            </xpath>
        </field>
    </record>

    <!-- Vista Búsqueda / Filtros de Product Template -->
    <record id="product_template_search_view_inherit_to_migrate" model="ir.ui.view">
        <field name="name">product.template.search.inherit.to.migrate</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_search_view"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='filter_to_purchase']" position="after">
                <filter string="Para Migrar" name="filter_to_migrate" domain="[('to_migrate', '=', True)]"/>
            </xpath>
            <xpath expr="//group" position="inside">
                <filter string="Para Migrar" name="group_by_to_migrate" context="{'group_by': 'to_migrate'}"/>
            </xpath>
        </field>
    </record>

</odoo>
